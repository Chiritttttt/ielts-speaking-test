generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id           String          @id @default(cuid())
  username     String          @unique
  password     String
  email        String?
  name         String?
  avatar       String?
  level        String          @default("intermediate")
  role         String          @default("user") // user, admin
  status       String          @default("pending") // pending, approved, rejected, suspended
  invitedBy    String?         // 邀请人 ID
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
  testSessions TestSession[]
  settings     UserSettings?
  inviteCodes  InviteCode[]    @relation("InviterCodes")
}

model UserSettings {
  id                      String   @id @default(cuid())
  userId                  String   @unique
  defaultVoice            String   @default("us-female")
  voiceSpeed              Float    @default(1.0)
  showQuestionAfterSpeech Boolean  @default(false)
  autoPlayQuestion        Boolean  @default(true)
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt
  user                    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model InviteCode {
  id          String    @id @default(cuid())
  code        String    @unique
  status      String    @default("active") // active, used, disabled
  maxUses     Int       @default(1) // 最大使用次数
  usedCount   Int       @default(0) // 已使用次数
  expiresAt   DateTime? // 过期时间，null 表示永不过期
  createdById String    // 创建者 ID
  usedBy      String?   // 使用者 ID
  usedAt      DateTime? // 使用时间
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  createdBy   User      @relation("InviterCodes", fields: [createdById], references: [id])
}

model TestSession {
  id               String            @id @default(cuid())
  userId           String?
  guestId          String?           // 访客 ID，用于追踪访客测试次数
  testType         String            @default("full")
  status           String            @default("in_progress")
  evaluationStatus String            @default("pending") // pending, evaluating, completed, failed
  totalScore       Float?
  bandScore        Float?
  part1Intro       String?
  part2Intro       String?
  part3Intro       String?
  evaluationProgress Int             @default(0) // 评估进度 0-100
  evaluationMessage String?          // 评估进度消息
  startedAt        DateTime          @default(now())
  completedAt      DateTime?
  evaluatedAt      DateTime?         // 评估完成时间
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  responses        SpeakingResponse[]
  user             User?             @relation(fields: [userId], references: [id])

  @@index([guestId]) // 为 guestId 添加索引，提高查询效率
}

// 访客使用记录 - 独立于测试会话，删除历史记录不影响
model GuestUsage {
  id        String   @id @default(cuid())
  guestId   String   @unique  // 访客 ID
  usedCount Int      @default(0)  // 已使用次数
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([guestId])
}

model SpeakingResponse {
  id                  String        @id @default(cuid())
  sessionId           String
  partNumber          Int
  questionId          String?
  questionText        String
  transcription       String?
  audioPath           String?       // 录音文件路径
  duration            Int?
  fluencyScore        Float?
  vocabularyScore     Float?
  grammarScore        Float?
  pronunciationScore  Float?
  overallScore        Float?
  feedback            String?
  improvements        String?
  strengths           String?
  modelAnswer         String?
  modelAnswerAudioPath String?     // 参考回答音频文件路径
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt
  session             TestSession   @relation(fields: [sessionId], references: [id], onDelete: Cascade)
}

model QuestionBank {
  id           String   @id @default(cuid())
  partNumber   Int
  category     String
  questionText String
  followUpQuestions String?
  difficulty   String   @default("medium")
  isActive     Boolean  @default(true)
  poolId       String?  // 所属题库 ID
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  pool         QuestionPool? @relation(fields: [poolId], references: [id], onDelete: SetNull)

  @@index([poolId, partNumber, category])
  @@index([isActive, poolId])
}

// 题库（如：2024年1-4月题库、2024年5-8月题库）
model QuestionPool {
  id          String   @id @default(cuid())
  name        String                    // 题库名称，如 "2024年1-4月题库"
  description String?                   // 题库描述
  period      String?                   // 题库周期，如 "2024-Q1", "2024-Q2"
  isActive    Boolean  @default(true)   // 是否启用
  isDefault   Boolean  @default(false)  // 是否为默认题库
  source      String   @default("ai")   // 来源: ai(自动生成), import(手动导入), official(官方)
  part1Count  Int      @default(0)      // Part 1 题目数量
  part2Count  Int      @default(0)      // Part 2 题目数量
  part3Count  Int      @default(0)      // Part 3 题目数量
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  questions   QuestionBank[]

  @@index([isActive, isDefault])
  @@index([period])
}

// 公告管理
model Announcement {
  id          String   @id @default(cuid())
  title       String                    // 公告标题
  content     String                    // 公告内容
  type        String   @default("info") // info, warning, maintenance, update
  isActive    Boolean  @default(true)   // 是否启用
  priority    Int      @default(0)      // 优先级，数字越大越靠前
  startDate   DateTime?                 // 开始显示时间
  endDate     DateTime?                 // 结束显示时间
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([isActive, priority])
}

// 地道表达
model IdiomaticExpression {
  id            String   @id @default(cuid())
  expression    String                    // 表达本身，如 "a piece of cake"
  meaning       String                    // 中文含义，如 "小菜一碟"
  meaningEn     String?                   // 英文解释
  category      String                    // 分类：collocation, idiom, phrasal_verb, slang
  topic         String?                   // 相关话题，如 "work", "study", "travel"
  level         String   @default("intermediate") // 难度：beginner, intermediate, advanced
  example       String?                   // 例句
  exampleCn     String?                   // 例句中文翻译
  usageTips     String?                   // 使用技巧
  ieltsScore    String?                   // 适合雅思分数段，如 "6-7", "7+"
  isCommon      Boolean  @default(false)  // 是否为常用表达
  isActive      Boolean  @default(true)   // 是否启用
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([category, topic])
  @@index([level, isCommon])
  @@index([isActive])
}

// 每日地道表达缓存
model DailyExpression {
  id              String   @id @default(cuid())
  date            String   @unique            // 日期，如 "2024-01-15"
  expression      String                    // 表达本身
  meaning         String                    // 中文含义
  meaningEn       String?                   // 英文解释
  pronunciation   String?                   // 发音提示
  category        String                    // 分类
  usageTips       String?                   // 使用技巧
  part1Example    String?                   // Part 1 应用示例
  part1ExampleCn  String?                   // Part 1 示例翻译
  part2Example    String?                   // Part 2 应用示例
  part2ExampleCn  String?                   // Part 2 示例翻译
  part3Example    String?                   // Part 3 应用示例
  part3ExampleCn  String?                   // Part 3 示例翻译
  commonMistakes  String?                   // 常见错误
  alternatives    String?                   // 同义替换
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([date])
}

// API 用量记录
model ApiUsage {
  id        String   @id @default(cuid())
  type      String                       // deepseek, whisper, tts
  action    String                       // evaluate, translate, generate, transcribe
  userId    String?
  success   Boolean  @default(true)
  tokens    Int      @default(0)         // token 消耗（DeepSeek）
  duration  Int      @default(0)         // 耗时（毫秒）
  date      String                       // 日期 YYYY-MM-DD，便于按日统计
  createdAt DateTime @default(now())

  @@index([type, date])
  @@index([action, date])
}
